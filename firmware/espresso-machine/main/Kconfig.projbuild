menu "PhilcoINO"

    config PHILCOINO_WIFI_SSID
        string "Wi-Fi SSID"
        default ""
        help
            Stored only in the generated, ignored sdkconfig file. Never add the
            actual value to sdkconfig.defaults or source files.

    config PHILCOINO_WIFI_PASSWORD
        string "Wi-Fi password"
        default ""
        help
            Stored only in the generated, ignored sdkconfig file. Never log it.

    config PHILCOINO_PAIRING_CODE
        string "Pairing code (exactly 8 digits)"
        default ""
        help
            Unique provisioned eight-digit numeric code, including any leading
            zeroes. Stored only in the generated, ignored sdkconfig file. The
            build rejects values that are not exactly eight digits. Never log it.

endmenu
