menu "PhilcoINO"

    config PHILCOINO_WIFI_SSID
        string "Wi-Fi SSID"
        default ""
        help
            Stored only in the generated, ignored sdkconfig file. Never add the
            actual value to sdkconfig.defaults or source files.

    config PHILCOINO_WIFI_PASSWORD
        string "Wi-Fi password"
        default ""
        help
            Stored only in the generated, ignored sdkconfig file. Never log it.

    config PHILCOINO_BEARER_TOKEN
        string "HTTP bearer token"
        default ""
        help
            Stored only in the generated, ignored sdkconfig file. Never log it.

    config PHILCOINO_PERFORMANCE_DIAGNOSTICS
        bool "Enable bounded performance diagnostics"
        default n
        help
            Enables fixed-allocation runtime counters and cold-path summary
            logging for supervised performance measurement. Adds no public API
            and remains disabled in normal builds.

    config PHILCOINO_BREW_PI_CONTROL
        bool "Use PI as Brew heater-duty authority"
        default n
        help
            Disabled keeps the legacy nonlinear Brew curve authoritative while
            PI runs in shadow diagnostics. Enabled makes PI the Brew requested-
            duty authority through the existing ten-second SSR window. Steam,
            faults, timeouts, cooldown, permission, lease, and fail-off
            ownership remain unchanged.

endmenu
